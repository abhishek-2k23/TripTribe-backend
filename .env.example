# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
MONGODB_URI=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRE=

# Security
BCRYPT_ROUNDS=

# Rate Limiting (config/rateLimits.js)
# Empty or absent = the built-in default for this NODE_ENV: loose in development, real numbers in
# production. Set any of them to override, in either environment.
#                       dev default   production default
RATE_LIMIT_WINDOW_MS=       # 300000        300000
RATE_LIMIT_MAX=             #  10000           300   authenticated routes, per user
RATE_LIMIT_PUBLIC_MAX=      #   2000            60   unauthenticated routes, per IP
RATE_LIMIT_SYNC_MAX=        #   5000           600   GET /api/sync/:tripId/rev, per user
RATE_LIMIT_JOB_MAX=         #   5000           900   AI job polling, per user
RATE_LIMIT_DISABLED=        # 1 turns the limiter off entirely
TRUST_PROXY=                # proxy hops in front of the server (Render/Nginx = 1)

# Web origins allowed to call this API, comma-separated (e.g. https://triptribe.app,http://localhost:5173).
# Empty means "allow any origin", which is fine locally and wrong in production.
CLIENT_URL=

# Expo push (design.md D-010). Only needed once push credentials are enforced; sends work without it.
EXPO_ACCESS_TOKEN=

# Clerk (sign-in)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Cloudinary (files and covers)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Claude — server-side only. Never put this in the mobile or web app.
ANTHROPIC_API_KEY=

# Inngest (AI background jobs).
# Leave all empty locally to run jobs in-process (not durable across restarts), or set INNGEST_DEV=1
# and run `npx inngest-cli@latest dev -u http://localhost:3000/api/inngest`.
# Production: set INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY from the Inngest dashboard.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Google Maps Platform server key (Places API (New) + Routes API). Required for AI trip plans.
GOOGLE_MAPS_SERVER_KEY=
